-- =========================================
-- 3. CREATE VIEW
-- =========================================

-- Create a view containing CSE students
CREATE VIEW CSE_Students AS
SELECT Student_ID, Student_Name, Marks, City
FROM Student
WHERE Department = 'CSE';


-- Display the View
SELECT * FROM CSE_Students;


-- =========================================
-- 4. CREATE ANOTHER VIEW
-- =========================================

-- View students who scored above 80
CREATE VIEW High_Scorers AS
SELECT Student_ID, Student_Name, Department, Marks
FROM Student
WHERE Marks > 80;


-- Display the View
SELECT * FROM High_Scorers;


-- =========================================
-- 5. CREATE INDEX
-- =========================================

-- Create index on Department column
CREATE INDEX idx_department
ON Student(Department);


-- Create index on Marks column
CREATE INDEX idx_marks
ON Student(Marks);


-- =========================================
-- 6. USING INDEXED COLUMN
-- =========================================

SELECT *
FROM Student
WHERE Department = 'CSE';


