-- Create Database
CREATE DATABASE CollegeDB;
USE CollegeDB;

-- =========================================
-- 1. CREATE STUDENT TABLE
-- =========================================

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Student_Name VARCHAR(50),
    Department VARCHAR(30),
    Marks INT,
    City VARCHAR(30)
);

